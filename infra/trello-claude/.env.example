# Copier ce fichier en .env (à côté de docker-compose-bobine.yml, jamais commité — voir
# .gitignore) et renseigner les vraies valeurs. docker-compose charge .env automatiquement.

# Token OAuth Claude Code (abonnement Pro/Max). Ne jamais définir ANTHROPIC_API_KEY à la
# place : sa seule présence bascule la facturation en mode API à l'usage.
CLAUDE_CODE_OAUTH_TOKEN=

# Clé + token API Trello (Power-Up admin > API Key, puis bouton "Token" pour le token membre).
TRELLO_API_KEY=
TRELLO_TOKEN=

# URL du webhook Discord utilisé pour les notifications de fin de pipeline.
DISCORD_WEBHOOK_URL=

# Salon Discord ciblé par le prompt envoyé à Claude.
DISCORD_CHANNEL_ID=1543573331335315497

# Personal Access Token GitHub utilisé par `gh`/`git` dans le conteneur bobine-repo.
GH_TOKEN=

# Secret partagé attendu en query param (?secret=...) de l'URL configurée dans la règle
# d'alerte Sentry ("Send a notification via a webhook"). Rejette toute requête qui ne le
# fournit pas. Génère une valeur aléatoire longue (ex. `openssl rand -hex 32`).
SENTRY_WEBHOOK_SECRET=

# Token API Sentry (Settings > Auth Tokens, scope minimal `event:read`, ajouter
# `event:write`/`project:write` si Claude doit pouvoir résoudre/commenter les issues) utilisé
# par Claude, dans le conteneur bobine-repo, pour aller chercher le détail d'une issue déclenchée
# par le webhook Sentry (skill `sentry-triage`).
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=
