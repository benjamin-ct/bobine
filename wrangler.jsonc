{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bobine",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bobine-notifications",
      "database_id": "b22c3b3e-0364-4c46-9c01-1bfb61368a45"
    }
  ],
  // Une fois par jour à 7h UTC : vérifie les nouveautés et envoie les
  // notifications push (voir worker/scheduled.js).
  "triggers": {
    "crons": ["0 7 * * *"]
  }
}
